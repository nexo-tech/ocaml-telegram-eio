## Usage

### How do I create a simple bot?

```ocaml
let () =
  let token = Sys.getenv "TELEGRAM_BOT_TOKEN" in

  Eio_main.run @@ fun env ->
  let client = Telegram.Client.create ~env ~token () in

  let handler update =
    let open Telegram_generated.Gen_types in
    match update.Update.message with
    | Some msg ->
        let chat_id = Telegram.Id.Chat.of_int msg.Message.chat.Chat.id in
        let text = Option.value msg.Message.text ~default:"" in
        if text <> "" then
          ignore (Gen_methods.send_message client ~chat_id ~text:("Echo: " ^ text) ())
    | None -> ()
  in

  Tg.Polling.run client ~handler
```

See `examples/` directory for more complete examples.

### How do I handle commands?

Parse commands from message text:

```ocaml
let handle_update update =
  let open Telegram_generated.Gen_types in
  match update.Update.message with
  | Some msg when String.starts_with ~prefix:"/" (Option.value msg.Message.text ~default:"") ->
      let chat_id = Telegram.Id.Chat.of_int msg.Message.chat.Chat.id in
      let text = Option.value msg.Message.text ~default:"" in

      (* Parse command *)
      let parts = String.split_on_char ' ' text in
      let cmd = List.hd parts in
      let args = List.tl parts in

      (match cmd with
       | "/start" ->
           Gen_methods.send_message client ~chat_id ~text:"Welcome!" ()
       | "/help" ->
           Gen_methods.send_message client ~chat_id ~text:"Commands: /start, /help" ()
       | _ ->
           Gen_methods.send_message client ~chat_id ~text:"Unknown command" ())
  | _ -> Ok ()
```

### How do I send photos or files?

```ocaml
(* Send from local file path - streaming upload *)
Gen_methods.send_photo client ~chat_id ~photo:"path/to/photo.jpg" ~caption:"My photo" ()

(* Send from URL *)
Gen_methods.send_photo client ~chat_id ~photo:"https://example.com/photo.jpg" ()

(* Send by file_id (already on Telegram servers) *)
Gen_methods.send_photo client ~chat_id ~photo:"AgACAgIAAxkBAAI..." ()

(* Send document *)
Gen_methods.send_document client ~chat_id ~document:"document.pdf" ~caption:"Here's the doc" ()
```

### How do I create keyboards?

```ocaml
(* Reply keyboard - persistent buttons *)
let keyboard = Keyboard.reply [
  ["Button 1"; "Button 2"];
  ["Button 3"];
] in
let reply_markup = Yojson.Safe.to_string keyboard in
Gen_methods.send_message client ~chat_id ~text:"Choose:" ~reply_markup ()

(* Inline keyboard - buttons with callbacks *)
let buttons = [
  [Keyboard.callback ~text:"Option A" ~data:"opt_a"];
  [Keyboard.callback ~text:"Option B" ~data:"opt_b"];
] in
let reply_markup = Keyboard.inline buttons in
Gen_methods.send_message client ~chat_id ~text:"Pick one:" ~reply_markup ()
```

### How do I handle callback queries?

```ocaml
let handle_update update =
  let open Telegram_generated.Gen_types in
  match update.Update.callback_query with
  | Some callback ->
      let data = Option.value callback.CallbackQuery.data ~default:"" in

      (* Process callback data *)
      (match data with
       | "opt_a" -> handle_option_a ()
       | "opt_b" -> handle_option_b ()
       | _ -> ());

      (* Always answer callback queries *)
      Gen_methods.answer_callback_query client
        ~callback_query_id:callback.CallbackQuery.id
        ~text:"Received!" ()
  | None -> Ok ()
```

### How do I handle errors?

Use pattern matching on Result:

```ocaml
match Gen_methods.send_message client ~chat_id ~text () with
| Ok message ->
    Printf.printf "Sent message ID: %d\n" message.Message.message_id;
    Ok ()
| Error err ->
    Printf.eprintf "Error: %a\n" Telegram.Error.pp err;
    Error err
```

Or use Result syntax for composition:

```ocaml
let open Telegram.Result_syntax in
let* msg1 = Gen_methods.send_message client ~chat_id ~text:"First" () in
let* msg2 = Gen_methods.send_message client ~chat_id ~text:"Second" () in
Ok (msg1, msg2)
```

### How do I implement retry logic?

```ocaml
let rec send_with_retry ~max_retries client ~chat_id ~text =
  match Gen_methods.send_message client ~chat_id ~text () with
  | Ok msg -> Ok msg
  | Error err when max_retries > 0 && Telegram.Error.is_retryable err ->
      (* Wait before retry *)
      (match Telegram.Error.retry_after err with
       | Some seconds -> Eio.Time.sleep clock (float_of_int seconds)
       | None -> Eio.Time.sleep clock 1.0);
      send_with_retry ~max_retries:(max_retries - 1) client ~chat_id ~text
  | Error err -> Error err
```


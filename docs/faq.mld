## Advanced Topics

### Can I use webhooks instead of polling?

Yes, webhook support is implemented (`Tg.Webhook`):

```ocaml
let handler _request update =
  (* Process update *)
  handle_update update;
  (* Return response *)
  Cohttp.Response.make ~status:`OK ()

let () =
  Eio_main.run @@ fun env ->
  let client = Telegram.Client.create ~env ~token () in

  (* Configure webhook *)
  let webhook_url = "https://example.com/webhook" in
  let* () = Gen_methods.set_webhook client ~url:webhook_url () in

  (* Start webhook server *)
  Tg.Webhook.run ~port:8443 ~handler client
```

### How do I handle rate limits?

Currently not built-in (Task 10.1 pending).

**Implement yourself:**
```ocaml
let rate_limiter = ref 0.0

let send_with_rate_limit client ~chat_id ~text =
  let now = Unix.gettimeofday () in
  let delay = max 0.0 (!rate_limiter -. now) in

  if delay > 0.0 then
    Eio.Time.sleep clock delay;

  rate_limiter := Unix.gettimeofday () +. 0.05;  (* 20 msg/sec *)
  Gen_methods.send_message client ~chat_id ~text ()
```

### Can I send messages concurrently?

Yes, use Eio fibers:

```ocaml
let send_to_multiple_chats client chats text =
  Eio.Fiber.all (List.map (fun chat_id ->
    fun () -> Gen_methods.send_message client ~chat_id ~text ()
  ) chats)
```

**Note**: Respect Telegram rate limits when sending to many chats.

### How do I parse entities (mentions, links, etc.)?

Message entities are in `message.entities`:

```ocaml
let extract_mentions msg =
  match msg.Message.entities with
  | Some entities ->
      List.filter_map (fun entity ->
        match entity.MessageEntity.type_ with
        | "mention" ->
            let text = Option.value msg.Message.text ~default:"" in
            let offset = Int64.to_int entity.MessageEntity.offset in
            let length = Int64.to_int entity.MessageEntity.length in
            Some (String.sub text offset length)
        | _ -> None
      ) entities
  | None -> []
```

### How do I implement conversation state?

Store state externally (database, in-memory map):

```ocaml
let user_states : (int64, string) Hashtbl.t = Hashtbl.create 100

let handle_message msg =
  let user_id = msg.Message.from.User.id in
  let state = Hashtbl.find_opt user_states user_id in

  match state with
  | Some "awaiting_name" ->
      let name = Option.value msg.Message.text ~default:"" in
      Hashtbl.replace user_states user_id "awaiting_age";
      send_message client ~chat_id ~text:("Hi " ^ name ^ "! How old are you?") ()
  | Some "awaiting_age" ->
      Hashtbl.remove user_states user_id;
      send_message client ~chat_id ~text:"Thanks!" ()
  | None ->
      Hashtbl.add user_states user_id "awaiting_name";
      send_message client ~chat_id ~text:"What's your name?" ()
```

**Note**: Session support (Tg.Session) is designed but not fully implemented.

### How do I test my bot?

**Unit testing**:
```ocaml
let test_command_parsing () =
  let cmd, args = parse_command "/start arg1 arg2" in
  Alcotest.(check string) "command" "/start" cmd;
  Alcotest.(check (list string)) "args" ["arg1"; "arg2"] args

let () =
  Alcotest.run "bot" [
    "parsing", [
      Alcotest.test_case "commands" `Quick test_command_parsing;
    ];
  ]
```

**Integration testing**:
See `test/integration_test.ml` for examples using local Bot API server.


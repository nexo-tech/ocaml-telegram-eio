{0 Testing Patterns}

Comprehensive guide to testing Telegram bots: unit testing handlers, mocking the Telegram API, integration testing, property-based testing, and test organization strategies.

{1 Overview}

Testing is essential for building reliable bots. The [ocaml_telegram_eio] library is designed for testability with:

- {b Pure handlers}: Separate business logic from I/O
- {b Dependency injection}: Pass clients and environment explicitly
- {b Mockable API}: Test without real Telegram servers
- {b Type safety}: Catch errors at compile time
- {b Test utilities}: Helpers for common testing scenarios

{2 When to Use This Guide}

Use these testing patterns when you need to:

- Verify bot logic works correctly
- Test without making real API calls
- Ensure changes don't break existing functionality
- Validate edge cases and error handling
- Test concurrent behavior
- Automate quality assurance

{1 Testing Strategy}

{2 Testing Pyramid}

{v
        /\
       /  \    E2E Tests (few)
      /____\
     /      \  Integration Tests (some)
    /________\
   /          \ Unit Tests (many)
  /__________\
v}

- {b Unit tests}: Test individual functions and handlers
- {b Integration tests}: Test components working together
- {b End-to-end tests}: Test complete user flows (optional)

{2 What to Test}

{b Do test}:
- Handler logic and business rules
- Command argument parsing
- State transitions
- Error handling paths
- Edge cases and validation

{b Don't test}:
- Telegram API implementation (trust the library)
- Network reliability (out of your control)
- Third-party libraries

{1 Unit Testing Handlers}

{2 Pure Function Handlers}

Extract business logic into pure functions:

{[
(* business_logic.ml - Pure, testable logic *)
module Business_logic = struct
  type validation_error =
    | Empty_name
    | Name_too_long
    | Invalid_email

  let validate_name name =
    if String.length name = 0 then
      Error Empty_name
    else if String.length name > 50 then
      Error Name_too_long
    else
      Ok name

  let validate_email email =
    if String.contains email '@' then
      Ok email
    else
      Error Invalid_email

  let format_greeting name =
    Printf.sprintf "Hello, %s! Welcome to our bot." name

  let calculate_discount price is_premium =
    if is_premium then
      price *. 0.8  (* 20% discount *)
    else
      price
end

(* business_logic_test.ml - Unit tests *)
let test_validate_name () =
  Alcotest.(check (result string reject))
    "valid name" (Ok "Alice")
    (Business_logic.validate_name "Alice");

  Alcotest.(check (result string reject))
    "empty name" (Error Business_logic.Empty_name)
    (Business_logic.validate_name "");

  Alcotest.(check (result string reject))
    "name too long" (Error Business_logic.Name_too_long)
    (Business_logic.validate_name (String.make 51 'a'))

let test_calculate_discount () =
  Alcotest.(check (float 0.01))
    "premium discount" 80.0
    (Business_logic.calculate_discount 100.0 true);

  Alcotest.(check (float 0.01))
    "no discount" 100.0
    (Business_logic.calculate_discount 100.0 false)
]}

{2 Testing Handler Logic}

{[
(* handlers.ml - Handlers using pure logic *)
module Handlers = struct
  open Tg.Bot

  let register_handler args ctx =
    match Args.expect_2 args with
    | Some (name, email) ->
        (* Validate inputs *)
        begin match Business_logic.validate_name name with
        | Error Empty_name ->
            let* _ = Ctx.reply ctx "Name cannot be empty" in
            ()
        | Error Name_too_long ->
            let* _ = Ctx.reply ctx "Name is too long (max 50 characters)" in
            ()
        | Ok valid_name ->
            begin match Business_logic.validate_email email with
            | Error Invalid_email ->
                let* _ = Ctx.reply ctx "Invalid email address" in
                ()
            | Ok valid_email ->
                (* Store registration *)
                let greeting = Business_logic.format_greeting valid_name in
                let* _ = Ctx.reply ctx greeting in
                ()
            end
        end

    | None ->
        let* _ = Ctx.reply ctx "Usage: /register <name> <email>" in
        ()
end

(* handlers_test.ml - Test handler logic separately *)
let test_validate_registration_args () =
  (* Test argument parsing *)
  let args = ["Alice"; "alice@example.com"] in
  match Bot.Args.expect_2 args with
  | Some (name, email) ->
      Alcotest.(check string) "name" "Alice" name;
      Alcotest.(check string) "email" "alice@example.com" email
  | None ->
      Alcotest.fail "Expected 2 arguments"

let test_registration_validation () =
  (* Test validation without I/O *)
  let valid = Business_logic.validate_name "Alice" in
  Alcotest.(check (result string reject)) "valid name" (Ok "Alice") valid;

  let invalid = Business_logic.validate_email "not-an-email" in
  Alcotest.(check (result string reject)) "invalid email"
    (Error Business_logic.Invalid_email) invalid
]}

{2 Testing Args Module}

{[
let test_args_parsing () =
  (* Test expect_1 *)
  Alcotest.(check (option string))
    "expect_1 success" (Some "hello")
    (Bot.Args.expect_1 ["hello"]);

  Alcotest.(check (option string))
    "expect_1 too many" None
    (Bot.Args.expect_1 ["hello"; "world"]);

  (* Test expect_2 *)
  Alcotest.(check (option (pair string string)))
    "expect_2 success" (Some ("a", "b"))
    (Bot.Args.expect_2 ["a"; "b"]);

  (* Test parse_int *)
  Alcotest.(check (option int))
    "parse_int success" (Some 42)
    (Bot.Args.parse_int "42");

  Alcotest.(check (option int))
    "parse_int failure" None
    (Bot.Args.parse_int "not-a-number");

  (* Test join_rest *)
  Alcotest.(check string)
    "join_rest" "hello world test"
    (Bot.Args.join_rest ["hello"; "world"; "test"] 0)
]}

{1 Mocking Telegram API}

{2 Mock Client}

Create a test double for the Telegram client:

{[
module Mock_client = struct
  type call_record = {
    method_name : string;
    params : (string * Yojson.Safe.t) list;
  }

  type t = {
    mutable calls : call_record list;
    mutable responses : (string, Yojson.Safe.t) Hashtbl.t;
  }

  let create () = {
    calls = [];
    responses = Hashtbl.create 16;
  }

  let record_call client method_name params =
    client.calls <- { method_name; params } :: client.calls

  let set_response client method_name response =
    Hashtbl.replace client.responses method_name response

  let get_calls client = List.rev client.calls

  let clear_calls client =
    client.calls <- []

  (* Implement call_method for testing *)
  let call_method client ~method_name params =
    record_call client method_name params;

    match Hashtbl.find_opt client.responses method_name with
    | Some response -> Ok response
    | None ->
        (* Default successful response *)
        Ok (`Assoc ["ok", `Bool true; "result", `Null])
end
]}

{2 Testing with Mock Client}

{[
let test_send_message_handler () =
  (* Create mock client *)
  let mock = Mock_client.create () in

  (* Set up expected response *)
  Mock_client.set_response mock "sendMessage"
    (`Assoc [
      "ok", `Bool true;
      "result", `Assoc [
        "message_id", `Int 123;
        "chat", `Assoc ["id", `Int 456; "type", `String "private"];
        "text", `String "Test message";
      ]
    ]);

  (* Call handler logic (simplified - not using real context) *)
  let chat_id = Telegram.Id.Chat.of_int 456L in
  let params = [
    ("chat_id", `Intlit "456");
    ("text", `String "Test message");
  ] in

  let result = Mock_client.call_method mock ~method_name:"sendMessage" params in

  (* Verify call was made *)
  let calls = Mock_client.get_calls mock in
  Alcotest.(check int) "one call made" 1 (List.length calls);

  let call = List.hd calls in
  Alcotest.(check string) "correct method" "sendMessage" call.method_name;

  (* Verify response *)
  Alcotest.(check bool) "call succeeded" true (Result.is_ok result)
]}


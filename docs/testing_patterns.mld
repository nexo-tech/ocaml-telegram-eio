(* Usage in tests *)
let test_command_handler () =
  let message = Mock_updates.make_command_message
    ~message_id:1
    ~chat_id:123L
    ~user_id:456L
    ~command:"start"
    ~args:""
    ()
  in

  let update = Mock_updates.make_update ~update_id:1 ~message () in

  (* Test that update has the expected structure *)
  match update.Update.message with
  | Some msg ->
      Alcotest.(check (option string)) "command text"
        (Some "/start") msg.Message.text
  | None ->
      Alcotest.fail "Expected message in update"
]}

{1 Integration Testing}

{2 Test Environment Setup}

{[
(* test_env.ml - Shared test environment *)
module Test_env = struct
  let test_token =
    match Sys.getenv_opt "TEST_BOT_TOKEN" with
    | Some token -> token
    | None -> "test_token_not_set"

  let should_run_integration_tests () =
    match Sys.getenv_opt "INTEGRATION_TESTS" with
    | Some "1" | Some "true" -> true
    | _ -> false

  let skip_if_no_integration () =
    if not (should_run_integration_tests ()) then
      Alcotest.skip ()
end
]}

{2 Integration Test Patterns}

{[
(* integration_test.ml *)
let test_send_and_receive () =
  Test_env.skip_if_no_integration ();

  Eio_main.run @@ fun env ->
  let client = Telegram.Client.create ~env ~token:Test_env.test_token () in

  (* Test getMe *)
  let me_result = Telegram_generated.Gen_methods.get_me client () in
  Alcotest.(check bool) "getMe succeeds" true (Result.is_ok me_result);

  match me_result with
  | Ok me ->
      Printf.printf "Bot username: @%s\n"
        (Option.value me.username ~default:"unknown")
  | Error err ->
      Alcotest.failf "getMe failed: %a" Telegram.Error.pp err

let test_polling_loop () =
  Test_env.skip_if_no_integration ();

  Eio_main.run @@ fun env ->
  let client = Telegram.Client.create ~env ~token:Test_env.test_token () in

  (* Test polling configuration *)
  let config = Tg.Polling.make ~timeout:1 ~limit:10 () in

  (* Run one iteration of polling (would need timeout in real test) *)
  Alcotest.(check bool) "polling config created" true true
]}

{2 Mock Server Testing}

{[
(* Use telegram-test-api or similar mock server *)
let test_with_mock_server () =
  (* Requires docker compose with telegram-test-api *)
  let mock_server_url = "http://localhost:9001" in

  Eio_main.run @@ fun env ->
  (* Create client pointing to mock server *)
  let client = Telegram.Client.create
    ~env
    ~token:"test_token"
    ~base_url:mock_server_url
    ()
  in

  (* Make API calls that hit the mock server *)
  let* result = Telegram_generated.Gen_methods.get_me client () in
  Alcotest.(check bool) "mock getMe succeeds" true (Result.is_ok result)
]}

{1 Property-Based Testing}

{2 QCheck Property Tests}

{[
open QCheck

(* Generator for valid usernames *)
let gen_username =
  Gen.string_size ~gen:(Gen.char_range 'a' 'z') (Gen.int_range 5 20)

(* Generator for message text *)
let gen_message_text =
  Gen.string_size Gen.printable (Gen.int_range 1 4096)

(* Property: Formatting and unformatting should be identity *)
let prop_format_roundtrip =
  Test.make ~name:"format HTML roundtrip"
    ~count:1000
    gen_message_text
    (fun text ->
      let formatted = escape_html text in
      let unformatted = unescape_html formatted in
      text = unformatted
    )

(* Property: Valid names should pass validation *)
let prop_valid_name_validates =
  Test.make ~name:"valid names pass validation"
    ~count:1000
    (Gen.string_size ~gen:Gen.alpha (Gen.int_range 1 50))
    (fun name ->
      match Business_logic.validate_name name with
      | Ok _ -> true
      | Error _ -> false
    )

(* Property: Long names should fail validation *)
let prop_long_name_fails =
  Test.make ~name:"long names fail validation"
    ~count:1000
    (Gen.string_size Gen.alpha (Gen.int_range 51 100))
    (fun name ->
      match Business_logic.validate_name name with
      | Error Business_logic.Name_too_long -> true
      | _ -> false
    )

(* Property: Args parsing is consistent *)
let prop_args_expect_n =
  Test.make ~name:"expect_n is consistent"
    ~count:1000
    (Gen.list_size (Gen.int_range 0 10) Gen.string)
    (fun args ->
      let n = List.length args in
      match n with
      | 1 -> Option.is_some (Bot.Args.expect_1 args)
      | 2 -> Option.is_some (Bot.Args.expect_2 args)
      | 3 -> Option.is_some (Bot.Args.expect_3 args)
      | _ -> true
    )

(* Run property tests *)
let () =
  QCheck_runner.run_tests [
    prop_format_roundtrip;
    prop_valid_name_validates;
    prop_long_name_fails;
    prop_args_expect_n;
  ]
]}

{2 Property-Based State Machine Testing}

{[
(* Test state machine properties *)
let gen_state =
  Gen.oneofl [Idle; AwaitingName; AwaitingAge; Complete]

let gen_input =
  Gen.oneofl ["start"; "Alice"; "25"; "confirm"; "cancel"]

let prop_state_machine_valid_transitions =
  Test.make ~name:"state machine valid transitions"
    ~count:1000
    (Gen.pair gen_state gen_input)
    (fun (state, input) ->
      (* Property: transition should always return a valid state *)
      match transition state input with
      | Some next_state -> is_valid_state next_state
      | None -> true  (* Invalid transitions are ok *)
    )
]}


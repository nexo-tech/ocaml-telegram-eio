v}

{2 Alcotest Test Suite}

{[
(* test_runner.ml - Main test suite *)
let () =
  Alcotest.run "Bot Tests" [
    (* Unit tests *)
    "business_logic", [
      Alcotest.test_case "validate name" `Quick test_validate_name;
      Alcotest.test_case "validate email" `Quick test_validate_email;
      Alcotest.test_case "calculate discount" `Quick test_calculate_discount;
    ];

    "args_parsing", [
      Alcotest.test_case "parse int" `Quick test_parse_int;
      Alcotest.test_case "parse bool" `Quick test_parse_bool;
      Alcotest.test_case "expect_1" `Quick test_args_expect_1;
      Alcotest.test_case "expect_2" `Quick test_args_expect_2;
    ];

    "handlers", [
      Alcotest.test_case "register validation" `Quick test_registration_validation;
      Alcotest.test_case "command parsing" `Quick test_command_parsing;
    ];

    (* Integration tests *)
    "integration", [
      Alcotest.test_case "send message" `Slow test_send_message;
      Alcotest.test_case "polling" `Slow test_polling_loop;
    ];
  ]
]}

{2 Test Fixtures and Helpers}

{[
(* test_fixtures.ml - Reusable test data *)
module Fixtures = struct
  let sample_user_id = 123456L
  let sample_chat_id = 789012L

  let sample_update =
    Mock_updates.make_update
      ~update_id:1
      ~message:(Mock_updates.make_text_message
        ~message_id:1
        ~chat_id:sample_chat_id
        ~user_id:sample_user_id
        ~text:"Hello"
        ()
      )
      ()

  let sample_command_update command args =
    Mock_updates.make_update
      ~update_id:1
      ~message:(Mock_updates.make_command_message
        ~message_id:1
        ~chat_id:sample_chat_id
        ~user_id:sample_user_id
        ~command
        ~args
        ()
      )
      ()
end

(* test_helpers.ml - Test utilities *)
module Test_helpers = struct
  let assert_ok result =
    match result with
    | Ok value -> value
    | Error err -> Alcotest.failf "Expected Ok, got Error: %s" err

  let assert_error result =
    match result with
    | Ok _ -> Alcotest.fail "Expected Error, got Ok"
    | Error err -> err

  let with_mock_client f =
    let mock = Mock_client.create () in
    f mock;
    Mock_client.clear_calls mock
end
]}

{1 Testing Concurrent Code}

{2 Testing Eio Fibers}

{[
let test_concurrent_handlers () =
  Eio_main.run @@ fun env ->

  (* Track which handlers ran *)
  let ran = ref [] in
  let mutex = Eio.Mutex.create () in

  let record name =
    Eio.Mutex.use_rw ~protect:true mutex (fun () ->
      ran := name :: !ran
    )
  in

  (* Run handlers concurrently *)
  Eio.Switch.run @@ fun sw ->
  Eio.Fiber.fork ~sw (fun () ->
    record "handler1"
  );
  Eio.Fiber.fork ~sw (fun () ->
    record "handler2"
  );
  Eio.Fiber.fork ~sw (fun () ->
    record "handler3"
  );

  (* Verify all ran *)
  Alcotest.(check int) "all handlers ran" 3 (List.length !ran);
  Alcotest.(check bool) "handler1 ran" true (List.mem "handler1" !ran);
  Alcotest.(check bool) "handler2 ran" true (List.mem "handler2" !ran);
  Alcotest.(check bool) "handler3 ran" true (List.mem "handler3" !ran)
]}

{2 Testing Rate Limiting}

{[
let test_rate_limiter () =
  let limiter = Rate_limiter.create ~max_per_minute:10 in
  let user_id = 123L in

  (* Should allow first 10 requests *)
  for i = 1 to 10 do
    let result = Rate_limiter.check_rate_limit limiter user_id in
    Alcotest.(check bool)
      (Printf.sprintf "request %d allowed" i)
      true
      (Result.is_ok result)
  done;

  (* 11th request should be rate limited *)
  let result = Rate_limiter.check_rate_limit limiter user_id in
  Alcotest.(check bool) "11th request blocked" true (Result.is_error result)
]}

{1 Best Practices}

{2 Test Design}

- {b Test behavior, not implementation}: Focus on what code does, not how
- {b One assertion per test}: Each test should verify one thing
- {b Arrange-Act-Assert}: Structure tests clearly
- {b Descriptive names}: Test names should describe what they verify
- {b Independent tests}: Tests shouldn't depend on each other

{2 Mock Strategy}

- {b Mock external dependencies}: Telegram API, databases, external services
- {b Don't mock what you own}: Test your own code directly
- {b Verify interactions}: Check that mocks are called correctly
- {b Use realistic data}: Test with data similar to production
- {b Test error paths}: Mock failures to test error handling

{2 Test Coverage}

- {b Cover happy paths}: Test normal, expected behavior
- {b Cover error paths}: Test validation, errors, edge cases
- {b Cover edge cases}: Empty inputs, maximum values, special characters
- {b Cover concurrency}: Test thread safety, race conditions
- {b Don't chase 100%}: Focus on critical paths

{2 Test Maintenance}

- {b Keep tests simple}: Tests should be easy to understand
- {b Avoid test interdependence}: Each test should run independently
- {b Use fixtures}: Share common test data
- {b Refactor tests}: Keep tests clean like production code
- {b Update tests with code}: Tests should evolve with features

{2 Performance Testing}

- {b Mark slow tests}: Use `\`Slow` tag for integration tests
- {b Run fast tests often}: Unit tests should run in milliseconds
- {b Separate test suites}: Unit tests separate from integration tests
- {b Parallel execution}: Run independent tests concurrently
- {b CI/CD optimization}: Fast tests in PR checks, slow tests nightly

{1 Example Test Suites}

{2 Complete Handler Test Suite}

{[
(* user_handler_test.ml *)
module User_handler_test = struct
  let test_register_valid_input () =
    let args = ["Alice"; "alice@example.com"] in

    (* Test argument parsing *)
    match Bot.Args.expect_2 args with
    | Some (name, email) ->
        (* Test validation *)
        let name_valid = Business_logic.validate_name name in
        Alcotest.(check (result string reject)) "name valid" (Ok "Alice") name_valid;

        let email_valid = Business_logic.validate_email email in
        Alcotest.(check (result string reject)) "email valid" (Ok "alice@example.com") email_valid
    | None ->
        Alcotest.fail "Args parsing failed"

  let test_register_empty_name () =
    let args = [""; "alice@example.com"] in

    match Bot.Args.expect_2 args with
    | Some (name, _email) ->
        let result = Business_logic.validate_name name in
        Alcotest.(check (result string reject))
          "empty name rejected"
          (Error Business_logic.Empty_name)
          result
    | None ->
        Alcotest.fail "Args parsing failed"

  let test_register_invalid_email () =
    let args = ["Alice"; "not-an-email"] in

    match Bot.Args.expect_2 args with
    | Some (_name, email) ->
        let result = Business_logic.validate_email email in
        Alcotest.(check (result string reject))
          "invalid email rejected"
          (Error Business_logic.Invalid_email)
          result
    | None ->
        Alcotest.fail "Args parsing failed"

  let tests = [
    "valid input", `Quick, test_register_valid_input;
    "empty name", `Quick, test_register_empty_name;
    "invalid email", `Quick, test_register_invalid_email;
  ]
end
]}

{2 State Machine Test Suite}

{[
module State_machine_test = struct
  let test_initial_state () =
    let state = Idle in
    Alcotest.(check bool) "starts in Idle" true (state = Idle)

  let test_transition_to_awaiting_name () =
    let next = transition Idle "register" in
    match next with
    | Some AwaitingName ->
        Alcotest.(check bool) "transitions to AwaitingName" true true
    | _ ->
        Alcotest.fail "Expected transition to AwaitingName"

  let test_invalid_transition () =
    let next = transition Idle "unknown_input" in
    Alcotest.(check (option reject)) "invalid transition returns None" None next

  let test_complete_flow () =
    (* Test full registration flow *)
    let state1 = Option.get (transition Idle "register") in
    Alcotest.(check bool) "step 1" true (state1 = AwaitingName);

    let state2 = Option.get (transition state1 "Alice") in
    Alcotest.(check bool) "step 2" true (state2 = AwaitingAge);

    let state3 = Option.get (transition state2 "25") in
    Alcotest.(check bool) "step 3" true (state3 = AwaitingConfirmation);

    let state4 = Option.get (transition state3 "confirm") in
    Alcotest.(check bool) "step 4" true (state4 = Complete)

  let tests = [
    "initial state", `Quick, test_initial_state;
    "transition to awaiting name", `Quick, test_transition_to_awaiting_name;
    "invalid transition", `Quick, test_invalid_transition;
    "complete flow", `Quick, test_complete_flow;
  ]
end
]}


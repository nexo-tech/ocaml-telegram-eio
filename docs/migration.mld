## Common patterns

### Polling loop with graceful shutdown

```ocaml
let () =
  Eio_main.run @@ fun env ->
  let client = Telegram.Client.create ~env ~token () in

  (* Polling runs until interrupted *)
  Tg.Polling.run client ~handler:(fun update ->
    match update.Update.message with
    | Some msg -> handle_message client msg
    | None -> ()
  )
```

### Concurrent message processing

```ocaml
let handle_update update =
  Eio.Fiber.both
    (fun () -> process_message update)
    (fun () -> log_update update)
  |> ignore
```

### Retry with exponential backoff

```ocaml
let rec send_with_retry ~retries client ~chat_id ~text =
  match Gen_methods.send_message client ~chat_id ~text () with
  | Ok msg -> Ok msg
  | Error err when retries > 0 && Telegram.Error.is_retryable err ->
      let backoff = 2.0 ** float_of_int (5 - retries) in
      Eio.Time.sleep clock backoff;
      send_with_retry ~retries:(retries - 1) client ~chat_id ~text
  | Error err -> Error err
```

### Type-safe callback data

```ocaml
(* Define your callback actions *)
type callback_action =
  | LikePost of int
  | SharePost of int
  | DeletePost of int
[@@deriving yojson]

(* Handle callback queries *)
match update.Update.callback_query with
| Some callback ->
    let data = Option.value callback.CallbackQuery.data ~default:"" in
    (match callback_action_of_yojson (Yojson.Safe.from_string data) with
     | Ok (LikePost post_id) -> handle_like post_id
     | Ok (SharePost post_id) -> handle_share post_id
     | Ok (DeletePost post_id) -> handle_delete post_id
     | Error _ -> (* handle invalid callback data *))
| None -> ()
```


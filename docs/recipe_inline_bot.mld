{2 Cached Results}

Use cached media with file IDs for faster responses:

{[
(* Create cached photo result *)
let create_cached_photo ~id ~file_id ~caption =
  let open Telegram_generated.Gen_types in

  InlineQueryResultCachedPhoto.{
    type_ = "photo";
    id;
    photo_file_id = file_id;
    title = None;
    description = None;
    caption = Some caption;
    parse_mode = Some "HTML";
    caption_entities = None;
    show_caption_above_media = None;
    reply_markup = None;
    input_message_content = None;
    unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
  }

(* Photo cache *)
let photo_cache = Hashtbl.create 100

(* Use cached or upload *)
let get_or_cache_photo client chat_id path key =
  match Hashtbl.find_opt photo_cache key with
  | Some file_id ->
      Ok file_id
  | None ->
      (* Upload and cache *)
      let photo = Telegram.Input_file.path path in
      match Telegram_generated.Gen_methods.send_photo client
              ~chat_id ~photo () with
      | Ok msg ->
          (match msg.photo with
          | Some (largest :: _) ->
              Hashtbl.add photo_cache key largest.file_id;
              Ok largest.file_id
          | _ -> Error "No photo in response")
      | Error e -> Error "Upload failed"
]}

{1 Result Caching}

{2 Server-Side Caching}

Control how long Telegram caches your results:

{[
(* Cache for 10 minutes *)
let answer_with_cache client iq results =
  Telegram_generated.Gen_methods.answer_inline_query client
    ~inline_query_id:iq.id
    ~results
    ~cache_time:600L  (* 10 minutes *)
    ()

(* No caching - always fresh results *)
let answer_no_cache client iq results =
  Telegram_generated.Gen_methods.answer_inline_query client
    ~inline_query_id:iq.id
    ~results
    ~cache_time:0L  (* No cache *)
    ()

(* Personal caching - per user *)
let answer_personal client iq results =
  Telegram_generated.Gen_methods.answer_inline_query client
    ~inline_query_id:iq.id
    ~results
    ~cache_time:300L
    ~is_personal:true  (* Cache per user *)
    ()
]}

{2 Client-Side Result Cache}

Cache search results in your bot to reduce computation:

{[
(* Result cache *)
module ResultCache = struct
  type cache_entry = {
    results : Telegram_generated.Gen_types.InlineQueryResult.t list;
    timestamp : float;
  }

  let cache = Hashtbl.create 1000
  let ttl = 300.0  (* 5 minutes *)

  let get query =
    match Hashtbl.find_opt cache query with
    | Some entry ->
        if Unix.time () -. entry.timestamp < ttl then
          Some entry.results
        else
          (Hashtbl.remove cache query; None)
    | None -> None

  let set query results =
    let entry = {
      results;
      timestamp = Unix.time ();
    } in
    Hashtbl.replace cache query entry

  let clear () =
    Hashtbl.clear cache
end

(* Use cache *)
let handle_inline_query client iq =
  let query = iq.query in

  match ResultCache.get query with
  | Some cached_results ->
      (* Use cached results *)
      answer_inline_query client iq cached_results

  | None ->
      (* Compute fresh results *)
      let results = compute_results query in
      ResultCache.set query results;
      answer_inline_query client iq results
]}


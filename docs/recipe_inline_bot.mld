{1 Pagination}

{2 Offset-Based Pagination}

Handle large result sets with pagination:

{[
(* Paginated search *)
let handle_paginated_query client iq all_results =
  let page_size = 50 in  (* Max 50 results per response *)

  (* Parse offset *)
  let offset =
    if String.length iq.offset = 0 then
      0
    else
      int_of_string_opt iq.offset |> Option.value ~default:0
  in

  (* Get page of results *)
  let total = List.length all_results in
  let start = offset in
  let end_ = min (offset + page_size) total in

  let page_results =
    all_results
    |> List.filteri (fun i _ -> i >= start && i < end_)
  in

  (* Calculate next offset *)
  let next_offset =
    if end_ < total then
      Some (string_of_int end_)
    else
      None
  in

  (* Answer with pagination *)
  Telegram_generated.Gen_methods.answer_inline_query client
    ~inline_query_id:iq.id
    ~results:page_results
    ?next_offset
    ()

(* Usage *)
let routes client = [
  Tg.Bot.on Tg.Bot.Event.inline_query (fun iq ctx ->
    let all_results = search_all iq.query in
    match handle_paginated_query client iq all_results with
    | Ok _ -> Ok ()
    | Error _ -> Ok ()
  );
]
]}

{2 Lazy Loading Pattern}

Load results on demand:

{[
(* Search with pagination *)
module PaginatedSearch = struct
  let page_size = 50

  (* Get page of results *)
  let get_page query offset =
    (* In real implementation: database query with LIMIT/OFFSET *)
    let all_results = database_search query in
    let start = offset in
    let end_ = min (offset + page_size) (List.length all_results) in
    List.filteri (fun i _ -> i >= start && i < end_) all_results

  (* Check if more results available *)
  let has_more query offset =
    let total_count = database_count query in
    offset + page_size < total_count

  (* Handle query with lazy loading *)
  let handle_query client iq =
    let query = iq.query in
    let offset = int_of_string_opt iq.offset |> Option.value ~default:0 in

    let results = get_page query offset in
    let next_offset =
      if has_more query offset then
        Some (string_of_int (offset + page_size))
      else
        None
    in

    Telegram_generated.Gen_methods.answer_inline_query client
      ~inline_query_id:iq.id
      ~results
      ?next_offset
      ()
end
]}


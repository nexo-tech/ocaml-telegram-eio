{0 Recipe: Inline Query Bot}

A comprehensive cookbook for building inline query bots that provide search results, rich content, and interactive experiences directly from any chat using inline mode.

{1 Overview}

This recipe demonstrates how to build bots that respond to inline queries. Users can type [@yourbotname query] in any chat to search and share content without switching to a private chat with your bot.

{b What you'll learn}:
- Handling inline queries
- Creating rich inline results (articles, photos, videos)
- Result caching for performance
- Inline keyboard integration
- Pagination for large result sets
- Location-based inline results

{b When to use inline query bots}:
- Search and content discovery
- Quick information lookup
- Sharing content across chats
- Location-based services
- Interactive tools and utilities

{1 Basic Inline Query Handling}

{2 Simple Inline Query Response}

Handle inline queries and return basic results:

{[
open Eio.Std
open Ocaml_telegram_eio

(* Handle inline query *)
let handle_inline_query client iq =
  let query_text = iq.Telegram_generated.Gen_types.InlineQuery.query in

  (* Create a simple article result *)
  let result =
    let open Telegram_generated.Gen_types in

    let input_content = InputTextMessageContent.{
      message_text = Printf.sprintf "You searched for: %s" query_text;
      parse_mode = None;
      entities = None;
      link_preview_options = None;
      unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
    } in

    InlineQueryResultArticle.{
      type_ = "article";
      id = "result_1";
      title = "Echo Search";
      input_message_content = InputTextMessageContent input_content;
      reply_markup = None;
      description = Some ("Echo: " ^ query_text);
      url = None;
      thumbnail_url = None;
      thumbnail_width = None;
      thumbnail_height = None;
      unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
    }
  in

  (* Answer the inline query *)
  Telegram_generated.Gen_methods.answer_inline_query client
    ~inline_query_id:iq.id
    ~results:[InlineQueryResult.InlineQueryResultArticle result]
    ()

(* Bot routes *)
let routes client = [
  Tg.Bot.on Tg.Bot.Event.inline_query (fun iq ctx ->
    match handle_inline_query client iq with
    | Ok _ -> Ok ()
    | Error _ -> Ok ()
  );
]
]}

{2 With Bot DSL}

Cleaner inline query handling with the Bot DSL:

{[
let routes client = [
  Tg.Bot.on Tg.Bot.Event.inline_query (fun iq ctx ->
    let query = iq.query in

    if String.length query = 0 then
      (* Empty query - show defaults *)
      let* _ = answer_inline_query client iq [] in
      Ok ()
    else
      (* Search and return results *)
      let results = search_content query in
      let* _ = answer_inline_query client iq results in
      Ok ()
  );
]
]}

{1 Rich Inline Results}

{2 Article Results}

Create article results with titles, descriptions, and rich content:

{[
(* Create article result *)
let create_article ~id ~title ~description ~text =
  let open Telegram_generated.Gen_types in

  let input_content = InputTextMessageContent.{
    message_text = text;
    parse_mode = Some "HTML";
    entities = None;
    link_preview_options = None;
    unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
  } in

  InlineQueryResultArticle.{
    type_ = "article";
    id;
    title;
    input_message_content = InputTextMessageContent input_content;
    reply_markup = None;
    description = Some description;
    url = None;
    thumbnail_url = None;
    thumbnail_width = None;
    thumbnail_height = None;
    unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
  }

(* Example: Wikipedia-style search *)
let search_articles query =
  [
    create_article
      ~id:"1"
      ~title:"OCaml Programming Language"
      ~description:"General-purpose programming language"
      ~text:"<b>OCaml</b> is a general-purpose, multi-paradigm programming language.";

    create_article
      ~id:"2"
      ~title:"Functional Programming"
      ~description:"Programming paradigm"
      ~text:"<b>Functional programming</b> is a programming paradigm...";
  ]
  |> List.map (fun article ->
      Telegram_generated.Gen_types.InlineQueryResult.InlineQueryResultArticle article)
]}


{2 Location-Aware Search}

Use user location for contextual results:

{[
let handle_location_query client iq =
  match iq.location with
  | Some location ->
      (* User shared location *)
      let lat = location.latitude in
      let lon = location.longitude in
      let results = search_nearby_venues lat lon iq.query in

      Telegram_generated.Gen_methods.answer_inline_query client
        ~inline_query_id:iq.id
        ~results
        ~cache_time:60L  (* Short cache for location-based *)
        ~is_personal:true
        ()

  | None ->
      (* No location - return generic results *)
      let results = search_generic iq.query in

      Telegram_generated.Gen_methods.answer_inline_query client
        ~inline_query_id:iq.id
        ~results
        ()
]}

{1 Complete Production Example}

{2 Wikipedia-Style Search Bot}

A complete inline bot for searching and sharing articles:

{[
open Eio.Std
open Ocaml_telegram_eio

(* Article database *)
type article = {
  id : int;
  title : string;
  summary : string;
  content : string;
  url : string;
  thumbnail : string option;
}

(* Sample articles *)
let articles = [
  { id = 1;
    title = "OCaml Programming Language";
    summary = "OCaml is a general-purpose, multi-paradigm programming language.";
    content = "<b>OCaml</b> is a general-purpose programming language with an emphasis on expressiveness and safety.";
    url = "https://ocaml.org";
    thumbnail = Some "https://ocaml.org/logo.png";
  };
  { id = 2;
    title = "Functional Programming";
    summary = "Programming paradigm based on mathematical functions.";
    content = "<b>Functional programming</b> is a programming paradigm where programs are constructed by applying and composing functions.";
    url = "https://en.wikipedia.org/wiki/Functional_programming";
    thumbnail = None;
  };
]

(* Search articles *)
let search_articles query =
  if String.length query < 2 then
    articles  (* Return all for short queries *)
  else
    let query_lower = String.lowercase_ascii query in
    List.filter (fun article ->
      String.contains (String.lowercase_ascii article.title) query_lower ||
      String.contains (String.lowercase_ascii article.summary) query_lower
    ) articles

(* Create inline keyboard for article *)
let create_article_keyboard url =
  let open Telegram_generated.Gen_types in

  InlineKeyboardMarkup.{
    inline_keyboard = [[
      InlineKeyboardButton.{
        text = "Read Full Article";
        url = Some url;
        callback_data = None;
        web_app = None;
        login_url = None;
        switch_inline_query = None;
        switch_inline_query_current_chat = None;
        switch_inline_query_chosen_chat = None;
        copy_text = None;
        callback_game = None;
        pay = None;
        unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
      };
      InlineKeyboardButton.{
        text = "Share";
        url = None;
        callback_data = None;
        web_app = None;
        login_url = None;
        switch_inline_query = Some "";
        switch_inline_query_current_chat = None;
        switch_inline_query_chosen_chat = None;
        copy_text = None;
        callback_game = None;
        pay = None;
        unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
      };
    ]];
    unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
  }

(* Convert article to inline result *)
let article_to_result article =
  let open Telegram_generated.Gen_types in

  let input_content = InputTextMessageContent.{
    message_text = article.content;
    parse_mode = Some "HTML";
    entities = None;
    link_preview_options = None;
    unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
  } in

  let result = InlineQueryResultArticle.{
    type_ = "article";
    id = string_of_int article.id;
    title = article.title;
    input_message_content = InputTextMessageContent input_content;
    reply_markup = Some (create_article_keyboard article.url);
    description = Some article.summary;
    url = Some article.url;
    thumbnail_url = article.thumbnail;
    thumbnail_width = None;
    thumbnail_height = None;
    unknown_fields = Telegram.Json_compat.Unknown_fields.create ();
  } in

  InlineQueryResult.InlineQueryResultArticle result

(* Handle inline query *)
let handle_inline_query client iq =
  let query = iq.Telegram_generated.Gen_types.InlineQuery.query in

  (* Search articles *)
  let matching_articles = search_articles query in

  (* Convert to inline results *)
  let results = List.map article_to_result matching_articles in

  (* Answer with caching *)
  Telegram_generated.Gen_methods.answer_inline_query client
    ~inline_query_id:iq.id
    ~results
    ~cache_time:300L  (* Cache for 5 minutes *)
    ~is_personal:false  (* Same results for all users *)
    ()

(* Bot routes *)
let routes client = [
  (* Start command *)
  Tg.Bot.on (Tg.Bot.Event.command "start") (fun _args ctx ->
    let* _ = Tg.Bot.Ctx.reply ctx
      "📚 Wikipedia-Style Search Bot\n\n\
       Use inline mode to search articles:\n\
       Type @yourbotname <query> in any chat!"
    in
    Ok ()
  );

  (* Inline query handler *)
  Tg.Bot.on Tg.Bot.Event.inline_query (fun iq ctx ->
    match handle_inline_query client iq with
    | Ok _ -> Ok ()
    | Error _ ->
        (* Send empty result on error *)
        let* _ = Telegram_generated.Gen_methods.answer_inline_query client
          ~inline_query_id:iq.id
          ~results:[]
          ()
        in
        Ok ()
  );
]

(* Main bot *)
let () =
  Eio_main.run @@ fun env ->
  let token = Sys.getenv "TELEGRAM_BOT_TOKEN" in
  let client = Telegram.Client.create ~env ~token in

  (* Create bot *)
  let bot = Tg.Bot.router (routes client) in

  (* Run polling *)
  Tg.Polling.run client (Tg.Bot.handle bot)
]}

{1 Best Practices}

{2 Query Processing}

- {b Empty queries}: Return default/popular results for empty queries
- {b Short queries}: Consider minimum query length (2-3 chars)
- {b Query normalization}: Lowercase, trim, handle special characters
- {b Fuzzy matching}: Consider typo tolerance for better UX
- {b Performance}: Keep search fast (<500ms for good UX)

{2 Result Design}

- {b Unique IDs}: Use stable, unique IDs for each result
- {b Title length}: Keep titles under 30 characters
- {b Description}: Add helpful descriptions (under 80 chars)
- {b Thumbnails}: Include thumbnails for visual appeal
- {b Relevance}: Order results by relevance to query

{2 Caching Strategy}

- {b Static content}: Long cache time (600-3600s)
- {b Dynamic content}: Short cache time (60-300s)
- {b User-specific}: Use `is_personal:true`
- {b Location-based}: Short cache + personal
- {b Client cache}: Cache computed results in your bot

{3 Cache Time Guidelines}

{[
(* Static content - 1 hour *)
~cache_time:3600L

(* Semi-static - 10 minutes *)
~cache_time:600L

(* Dynamic - 5 minutes *)
~cache_time:300L

(* Real-time - 1 minute *)
~cache_time:60L

(* No cache *)
~cache_time:0L
]}

{2 Pagination}

- {b Page size}: Use 20-50 results per page
- {b Total limit}: Consider maximum total results (500-1000)
- {b Lazy loading}: Only compute results when needed
- {b Performance}: Don't load all results upfront
- {b User experience}: Provide smooth scrolling

{2 Error Handling}

- {b Always answer}: Never leave queries unanswered
- {b Empty results}: Return empty list, not error
- {b Timeouts}: Set reasonable timeout for searches
- {b Fallback}: Provide default results on error
- {b Logging}: Log errors for debugging

{2 Security}

- {b Input validation}: Sanitize query strings
- {b Rate limiting}: Prevent abuse with too many queries
- {b Content filtering}: Filter inappropriate content
- {b URL validation}: Validate external URLs in results
- {b User permissions}: Check user access rights


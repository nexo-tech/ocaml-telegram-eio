{1 Advanced Patterns}

{2 Message Queue}

Rate-limited message sending:

{[
type message_queue = {
  messages : (int64 * string) Queue.t;
  rate_limit : float;  (* seconds between messages *)
  mutable last_send : float;
}

let create_queue ?(rate_limit=0.1) () = {
  messages = Queue.create ();
  rate_limit;
  last_send = 0.0;
}

let enqueue queue chat_id text =
  Queue.push (chat_id, text) queue.messages

let process_queue env client queue =
  Eio.Fiber.fork ~sw (fun () ->
    while true do
      match Queue.take_opt queue.messages with
      | Some (chat_id, text) ->
          (* Rate limiting *)
          let now = Unix.time () in
          let wait = queue.rate_limit -. (now -. queue.last_send) in
          if wait > 0.0 then
            Eio.Time.sleep env#clock wait;

          (* Send message *)
          (match Telegram_generated.Gen_methods.send_message
            client
            ~chat_id:(Telegram.Id.Chat.of_int64 chat_id)
            ~text
            () with
           | Ok _ -> queue.last_send <- Unix.time ()
           | Error err -> Eio.traceln "Send error: %a" Telegram.Error.pp err);

      | None ->
          Eio.Time.sleep env#clock 0.1  (* Wait for messages *)
    done
  )
]}

{2 Message History}

Track conversation history:

{[
type conversation = {
  chat_id : int64;
  messages : message list ref;
  max_history : int;
}

let create_conversation chat_id ?(max_history=100) () = {
  chat_id;
  messages = ref [];
  max_history;
}

let add_message conv msg =
  conv.messages := msg :: !(conv.messages);

  (* Trim to max_history *)
  if List.length !(conv.messages) > conv.max_history then
    conv.messages := List.take conv.max_history !(conv.messages)

let get_recent conv n =
  List.take (min n (List.length !(conv.messages))) !(conv.messages)

let find_text conv pattern =
  !(conv.messages)
  |> List.filter (fun msg ->
    match msg.text with
    | Some text -> String.contains text pattern
    | None -> false
  )
]}

{2 Message Reactions Handling}

{[
let handle_message_update update =
  match update with
  (* New message *)
  | { message = Some msg; _ } ->
      Eio.traceln "New message: %Ld" msg.message_id;
      Ok ()

  (* Edited message *)
  | { edited_message = Some msg; _ } ->
      Eio.traceln "Message %Ld was edited" msg.message_id;
      (match msg.edit_date with
       | Some timestamp ->
           Eio.traceln "Edited at: %Ld" timestamp
       | None -> ());
      Ok ()

  (* Message reaction (if enabled) *)
  | { message_reaction = Some reaction; _ } ->
      Eio.traceln "Reaction on message %Ld" reaction.message_id;
      Ok ()

  | _ ->
      Ok ()
]}

{1 Best Practices}

{2 Always Escape User Input}

{[
(* ❌ Dangerous - HTML injection *)
let bad_example client chat_id user_input =
  let text = Printf.sprintf "You said: %s" user_input in
  send_html client chat_id text

(* ✅ Safe - escaped *)
let good_example client chat_id user_input =
  let safe = escape_html user_input in
  let text = Printf.sprintf "You said: <code>%s</code>" safe in
  send_html client chat_id text
]}

{2 Handle Long Messages}

{[
let send_long_text client chat_id text =
  let max_length = 4096 in

  if String.length text <= max_length then
    (* Send normally *)
    Telegram_generated.Gen_methods.send_message
      client ~chat_id:(Telegram.Id.Chat.of_int64 chat_id) ~text ()
  else
    (* Split into chunks *)
    let rec send_chunks offset =
      if offset >= String.length text then
        Ok ()
      else
        let chunk_len = min max_length (String.length text - offset) in
        let chunk = String.sub text offset chunk_len in

        let* _ = Telegram_generated.Gen_methods.send_message
          client ~chat_id:(Telegram.Id.Chat.of_int64 chat_id) ~text:chunk () in

        send_chunks (offset + chunk_len)
    in
    send_chunks 0
]}

{2 Preserve Formatting Across Operations}

{[
let edit_preserving_format client chat_id message_id new_text original_msg =
  (* Detect original format *)
  let parse_mode = match original_msg.entities with
    | Some entities when List.exists (fun e -> e.type_ = "bold" || e.type_ = "italic") entities ->
        Some `HTML
    | _ -> None
  in

  Telegram_generated.Gen_methods.edit_message_text
    client
    ~chat_id:(Telegram.Id.Chat.of_int64 chat_id)
    ~message_id
    ~text:new_text
    ?parse_mode
    ()
]}


{2 Deleting Messages}

{[
let delete_message client chat_id message_id =
  Telegram_generated.Gen_methods.delete_message
    client
    ~chat_id:(Telegram.Id.Chat.of_int64 chat_id)
    ~message_id
    ()

(* Delete after delay *)
let delete_after_delay env client chat_id message_id seconds =
  Eio.Fiber.fork ~sw (fun () ->
    Eio.Time.sleep env#clock (float_of_int seconds);
    match delete_message client chat_id message_id with
    | Ok _ -> Eio.traceln "Deleted message %Ld" message_id
    | Error err -> Eio.traceln "Failed to delete: %a" Telegram.Error.pp err
  )
]}


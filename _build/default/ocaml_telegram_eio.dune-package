(lang dune 3.17)
(name ocaml_telegram_eio)
(sections (lib .) (libexec .) (bin ../../bin))
(files
 (lib
  (META
   dune-package
   opam
   telegram/api.ml
   telegram/api.mli
   telegram/client.ml
   telegram/client.mli
   telegram/error.ml
   telegram/error.mli
   telegram/http.ml
   telegram/http.mli
   telegram/id.ml
   telegram/id.mli
   telegram/request.ml
   telegram/request.mli
   telegram/spec_ast.ml
   telegram/spec_ast.mli
   telegram/spec_norm.ml
   telegram/spec_norm.mli
   telegram/telegram.a
   telegram/telegram.cma
   telegram/telegram.cmi
   telegram/telegram.cmt
   telegram/telegram.cmx
   telegram/telegram.cmxa
   telegram/telegram.ml
   telegram/telegram__Api.cmi
   telegram/telegram__Api.cmt
   telegram/telegram__Api.cmti
   telegram/telegram__Api.cmx
   telegram/telegram__Client.cmi
   telegram/telegram__Client.cmt

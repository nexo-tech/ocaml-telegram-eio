 (libexec (telegram/telegram.cmxs tg/tg.cmxs))
 (bin
  (ocaml_telegram_eio.spec_methods
   ocaml_telegram_eio.spec_scan
   ocaml_telegram_eio.spec_types)))
(library
 (name ocaml_telegram_eio.telegram)
 (kind normal)
 (archives (byte telegram/telegram.cma) (native telegram/telegram.cmxa))
 (plugins (byte telegram/telegram.cma) (native telegram/telegram.cmxs))
 (native_archives telegram/telegram.a)
 (requires
  eio
  yojson
  cohttp-eio
  ppx_deriving.runtime
  ppx_deriving_yojson.runtime)
 (main_module_name Telegram)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name telegram)
     (visibility public)
     (kind alias)
     (source (path Telegram) (impl (path telegram/telegram.ml-gen))))
    (name Telegram)
    (modules
     (module
      (obj_name telegram__Api)
      (visibility public)
      (source
       (path Api)
       (intf (path telegram/api.mli))
       (impl (path telegram/api.ml))))
     (module
      (obj_name telegram__Client)
      (visibility public)
      (source
       (path Client)
       (intf (path telegram/client.mli))
       (impl (path telegram/client.ml))))
     (module
      (obj_name telegram__Error)
      (visibility public)
      (source
       (path Error)
       (intf (path telegram/error.mli))
       (impl (path telegram/error.ml))))
     (module
      (obj_name telegram__Http)
      (visibility public)
      (source
       (path Http)
       (intf (path telegram/http.mli))
       (impl (path telegram/http.ml))))
     (module
      (obj_name telegram__Id)
      (visibility public)
      (source
       (path Id)
       (intf (path telegram/id.mli))
       (impl (path telegram/id.ml))))
     (module
      (obj_name telegram__Request)
      (visibility public)
      (source
       (path Request)
       (intf (path telegram/request.mli))
       (impl (path telegram/request.ml))))
     (module
      (obj_name telegram__Spec_ast)
      (visibility public)
      (source
       (path Spec_ast)
       (intf (path telegram/spec_ast.mli))
       (impl (path telegram/spec_ast.ml))))
     (module
      (obj_name telegram__Spec_norm)
      (visibility public)
      (source
       (path Spec_norm)
       (intf (path telegram/spec_norm.mli))
       (impl (path telegram/spec_norm.ml))))
     (module
      (obj_name telegram__Types)
      (visibility public)
      (source
       (path Types)
       (intf (path telegram/types.mli))
       (impl (path telegram/types.ml))))
     (module
      (obj_name telegram__Version)
      (visibility public)
      (source
       (path Version)
       (intf (path telegram/version.mli))
       (impl (path telegram/version.ml))))))
   (wrapped true))))
(library
 (name ocaml_telegram_eio.tg)
 (kind normal)
 (archives (byte tg/tg.cma) (native tg/tg.cmxa))
 (plugins (byte tg/tg.cma) (native tg/tg.cmxs))
 (native_archives tg/tg.a)
 (requires eio yojson ocaml_telegram_eio.telegram)
 (main_module_name Tg)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name tg)
     (visibility public)
     (kind alias)
     (source (path Tg) (impl (path tg/tg.ml-gen))))
    (name Tg)
    (modules
     (module
      (obj_name tg__Action)
      (visibility public)
      (source
       (path Action)
       (intf (path tg/action.mli))
       (impl (path tg/action.ml))))
     (module
      (obj_name tg__Bot)
      (visibility public)
      (source (path Bot) (intf (path tg/bot.mli)) (impl (path tg/bot.ml))))
     (module
      (obj_name tg__Keyboard)
      (visibility public)
      (source
       (path Keyboard)
       (intf (path tg/keyboard.mli))
       (impl (path tg/keyboard.ml))))
     (module
      (obj_name tg__Msg)
      (visibility public)
      (source (path Msg) (intf (path tg/msg.mli)) (impl (path tg/msg.ml))))
     (module
      (obj_name tg__Result_syntax)
      (visibility public)
      (source
       (path Result_syntax)
       (intf (path tg/result_syntax.mli))
       (impl (path tg/result_syntax.ml))))
     (module
      (obj_name tg__Session)
      (visibility public)
      (source
       (path Session)
       (intf (path tg/session.mli))
       (impl (path tg/session.ml))))))
   (wrapped true))))
